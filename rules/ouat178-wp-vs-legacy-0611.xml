<?xml version="1.0" encoding="UTF-8"?>
<!-- OUAT-178: CFS WP Greeks of a new UAT pricing run for value date 2026-11-06 against the legacy prod output for the same date.
     The legacy numbers are fixed below (taken from legacy MySQL and from the migrated UAT rows of 10 Nov, identical), because a
     UAT rerun overwrites the migrated rows. Read only. Run after the mapping load, with engine PR 49 deployed, after the CFS rerun. -->
<rules name="ouat178-wp-vs-legacy-0611">
  <sql id="legacy" db="postgres-uat" export="full"><![CDATA[
    SELECT * FROM (VALUES
      ('CM WP 20261215.K27 CM WP 20261215.K27 P 125 CS', 4.017704586204098::float8, -0.4541451917061226::float8, 0.4589721693239362::float8, 0.4705075609880094::float8, -0.05615295038297852::float8),
      ('CM WP H27.H27 CM WP H27.H27 P 106 CS',           4.412003441271932::float8, -0.40679004050623185::float8, 0.41490289997033863::float8, 0.48706951201544335::float8, -0.031760355066234425::float8),
      ('CM WP Z26.Z26 CM WP H27.H27 P 77 CS',            0::float8, 0::float8, 0::float8, 0::float8, 0::float8)
    ) AS t(security_id, settle_price, settle_delta_1, settle_delta_2, settle_vega_1, settle_theta)
  ]]></sql>
  <sql id="uat" db="postgres-uat" export="full"><![CDATA[
    SELECT security_id, settle_price, settle_delta_1, settle_delta_2, settle_vega_1, settle_theta, created_timestamp AS written_utc
    FROM opera.security_settlement_value_table
    WHERE tenant_id = '227cd5f5-4498-4dba-bda9-05b8edc41113' AND business_unit = 'CFS' AND value_date = DATE '2026-11-06'
      AND security_id IN ('CM WP 20261215.K27 CM WP 20261215.K27 P 125 CS', 'CM WP H27.H27 CM WP H27.H27 P 106 CS', 'CM WP Z26.Z26 CM WP H27.H27 P 77 CS')
  ]]></sql>
  <sql id="mapping" db="postgres-uat" export="full"><![CDATA[
    SELECT business_unit, product_code, primary_code, secondary_code, primary_multiplier, secondary_multiplier
    FROM opera.correl_product_mapping WHERE tenant_id = '227cd5f5-4498-4dba-bda9-05b8edc41113' ORDER BY 1, 2
  ]]></sql>
  <compare id="cmp" source="legacy" target="uat" export="full">
    <key columns="security_id"/>
    <column name="settle_price" numeric="true" absTol="0.0001"/>
    <column name="settle_delta_1" numeric="true" absTol="0.0001"/>
    <column name="settle_delta_2" numeric="true" absTol="0.0001"/>
    <column name="settle_vega_1" numeric="true" absTol="0.0001"/>
    <column name="settle_theta" numeric="true" absTol="0.0001"/>
  </compare>
  <expect ref="mapping" rows="4" reason="the 4 CFS mapping rows must be loaded before the rerun"/>
  <expect ref="uat" rows="3" reason="the rerun wrote the 3 CFS WP rows for 6 Nov"/>
  <expect ref="cmp" different="0" only-source="0" only-target="0" reason="UAT equals legacy to 4 decimals"/>
  <compress id="bundle" file="ouat178-wp-vs-legacy-0611.zip">
    <include ref="legacy"/>
    <include ref="uat"/>
    <include ref="mapping"/>
    <include ref="cmp"/>
  </compress>
</rules>
