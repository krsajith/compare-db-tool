<?xml version="1.0" encoding="UTF-8"?>
<!-- Cash refresh 12: read-only check after the cash-refresh-restore-cfs-ssv-20261002 restore was applied.
     Expect CFS only 2026-10-02 with 314,822 rows, equal to the 04-Oct copy and MySQL history, target security 5.2204.
     The <expect> elements below state exactly that: SUMMARY.md says PASS or FAIL and the exit code is 0 only on PASS.
     The restore rule runs this file by itself after the restore is applied (its "verify" entry). -->
<rules name="cash-refresh-12-verify-restore-cfs">
  <parameters>
    <param name="valueDate" type="date" value="2026-10-02"/>
  </parameters>

  <sql id="pg-current-ssv-cfs" db="postgres-dev" timeout="180" fetchSize="500" export="sample"><![CDATA[
    SELECT security_id, value_date, settle_price
    FROM opera.security_settlement_value_table
    WHERE tenant_id = '227cd5f5-4498-4dba-bda9-05b8edc41113'
      AND business_unit = 'CFS'
  ]]></sql>

  <sql id="pg-backup-ssv-cfs" db="postgres-dev" timeout="180" fetchSize="500" export="sample"><![CDATA[
    SELECT security_id, value_date, settle_price
    FROM opera_backup_04_10.security_settlement_value_table
    WHERE tenant_id = '227cd5f5-4498-4dba-bda9-05b8edc41113'
      AND business_unit = 'CFS' AND value_date = :valueDate
  ]]></sql>

  <sql id="mysql-history-ssv-cfs" db="mysql-oprdb02" timeout="300" fetchSize="500" export="sample"><![CDATA[
    SELECT security_id, value_date, settle_price
    FROM dbsystemuat.historical_security_settlement_value_table_cfs
    WHERE value_date = :valueDate
  ]]></sql>

  <sql id="pg-current-by-date" db="postgres-dev" timeout="120" fetchSize="50" export="full"><![CDATA[
    SELECT value_date, count(*) AS row_count
    FROM opera.security_settlement_value_table
    WHERE tenant_id = '227cd5f5-4498-4dba-bda9-05b8edc41113' AND business_unit = 'CFS'
    GROUP BY value_date ORDER BY value_date
  ]]></sql>

  <sql id="pg-target-security" db="postgres-dev" timeout="60" fetchSize="50" export="full"><![CDATA[
    SELECT security_id, value_date, settle_price
    FROM opera.security_settlement_value_table
    WHERE tenant_id = '227cd5f5-4498-4dba-bda9-05b8edc41113' AND business_unit = 'CFS'
      AND security_id = 'CR BCNUSD NDF 20261001'
  ]]></sql>

  <compare id="current-vs-backup-copy" source="pg-backup-ssv-cfs" target="pg-current-ssv-cfs">
    <key columns="security_id,value_date"/>
    <column name="settle_price"/>
  </compare>

  <compare id="current-vs-mysql-history" source="mysql-history-ssv-cfs" target="pg-current-ssv-cfs">
    <key columns="security_id,value_date"/>
    <column name="settle_price"/>
  </compare>

  <expect ref="pg-current-by-date" rows="1" reason="CFS holds one value date only (the 07-Jul load is gone)"/>
  <expect ref="pg-current-by-date" column="value_date" equals="2026-10-02" reason="the restored date"/>
  <expect ref="pg-current-by-date" column="row_count" equals="314822" reason="rows of the 04-Oct copy"/>
  <expect ref="pg-target-security" rows="1" reason="CR BCNUSD NDF 20261001 has its 02-Oct price again"/>
  <expect ref="pg-target-security" column="settle_price" equals="5.2204" reason="underlying settle value used by S7"/>
  <expect ref="current-vs-backup-copy" different="0" only-source="0" only-target="0" reason="current equals the 04-Oct migration copy"/>
  <expect ref="current-vs-mysql-history" different="0" only-source="0" only-target="0" reason="current equals MySQL history"/>

  <!-- if the current CFS prices differ from the 04-Oct copy, say which restore rule to preview (it only suggests; nothing is restored) -->
  <suggest restore="cash-refresh-restore-cfs-ssv-20261002.json"
           when="#c('current-vs-backup-copy').onlySource &gt; 0 or #c('current-vs-backup-copy').onlyTarget &gt; 0 or #c('current-vs-backup-copy').different &gt; 0"
           reason="the current CFS prices differ from the 04-Oct copy"/>

  <compress id="bundle" file="cash-refresh-12-verify-restore-cfs.zip">
    <include ref="pg-current-by-date"/>
    <include ref="pg-target-security"/>
    <include ref="current-vs-backup-copy"/>
    <include ref="current-vs-mysql-history"/>
  </compress>
</rules>
